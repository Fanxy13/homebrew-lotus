#!/bin/zsh
# lotus – start screen and command center for the macOS terminal
setopt extendedglob
# Homebrew runs install steps with a temporary $HOME – use the real one
if [[ $LOTUS_FOR_USER == [[:alnum:]._-]## ]]; then
  _home=${~:-~$LOTUS_FOR_USER}
  [[ $_home == /* && -d $_home ]] && HOME=$_home
fi
source ${0:A:h:h}/lib/core.zsh
source $LOTUS_ROOT/lib/ui.zsh
source $LOTUS_ROOT/lib/fuzzy.zsh

LOTUS_RC=${ZDOTDIR:-$HOME}/.zshrc

# Window size, in case the script did not inherit it
if [[ -t 1 ]]; then
  _size=(${=$(stty size < /dev/tty 2>/dev/null)})
  (( ${#_size} == 2 )) && { LINES=$_size[1]; COLUMNS=$_size[2] }
fi

# Subcommand → module in lib/cmd (loaded only when needed)
typeset -A LOTUS_MODULES=(
  setup system  update system  upgrade system  doctor system  uninstall system  unhook system
  help help  -h help  --help help  cheatsheet help  themes help  suggest help
  web web  github web  goat web  browse web  google web  search web  open web
  app app  brew brew  install install  audio audio  weather weather  ai ai
  ios ios  minecraft minecraft  mc minecraft  convert convert  visual visual
  shortcuts shortcuts  shortcut shortcuts  run shortcuts  logo logo
)

lotus_load
cmd=${1:-show}
(( $# )) && shift

case $cmd in
  show)
    if (( ! LOTUS_CONFIGURED )) && [[ -t 0 && -t 1 ]]; then
      source $LOTUS_ROOT/lib/cmd/setup.zsh; lotus_cmd_setup_wizard
    fi
    lotus_render ;;
  settings|config)
    source $LOTUS_ROOT/lib/settings.zsh; lotus_settings_ui; exit $? ;;
  version|-v|--version)
    print -r -- $LOTUS_VERSION ;;
  *)
    module=$LOTUS_MODULES[$cmd]
    if [[ -z $module ]]; then
      source $LOTUS_ROOT/lib/cmd/help.zsh
      lotus_cmd_suggest $cmd "$@"
      exit 1
    fi
    source $LOTUS_ROOT/lib/cmd/$module.zsh
    lotus_cmd_$module $cmd "$@"
    exit $? ;;
esac
