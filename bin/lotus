#!/bin/zsh
# lotus – a beautiful start screen for the macOS terminal
setopt extendedglob
source ${0:A:h:h}/lib/core.zsh

LOTUS_REPO=Fanxy13/homebrew-lotus
LOTUS_RC=${ZDOTDIR:-$HOME}/.zshrc

say()  { print -P "%F{green}🪷%f $*" }

is_brew() { [[ $LOTUS_ROOT == */(Cellar|Caskroom)/lotus/* ]] }

# Window size, in case the script did not inherit it
if [[ -t 1 ]]; then
  _size=(${=$(stty size < /dev/tty 2>/dev/null)})
  (( ${#_size} == 2 )) && { LINES=$_size[1]; COLUMNS=$_size[2] }
fi

cmd_setup() {
  [[ -e $LOTUS_CONF/settings.zsh ]] || lotus_save
  lotus_build force

  # Finds lotus through the `lotus` command itself, so the line keeps working
  # after Homebrew upgrades (new version folder) – without starting a process
  local block="# >>> lotus >>>"$'\n'
  if [[ $LOTUS_ROOT == $HOME/.local/share/lotus && ${path[(I)$HOME/.local/bin]} == 0 ]]; then
    block+='export PATH="$HOME/.local/bin:$PATH"'$'\n'
  fi
  block+='(( $+commands[lotus] )) && source ${${commands[lotus]:A}:h:h}/lib/init.zsh'$'\n'"# <<< lotus <<<"

  local rc=
  [[ -r $LOTUS_RC ]] && rc=$(<$LOTUS_RC)
  if [[ $rc == *'# >>> lotus >>>'*'# <<< lotus <<<'* ]]; then
    rc=${rc/'# >>> lotus >>>'*'# <<< lotus <<<'/$block}
  else
    rc+=${rc:+$'\n\n'}$block
  fi
  print -r -- $rc >| $LOTUS_RC
  say "$LOTUS_L[added_to] $LOTUS_RC"
  say $LOTUS_L[open_new]
}

# Removes everything lotus created. With --yes no question is asked.
cmd_uninstall() {
  if [[ $1 != --yes ]]; then
    read -q "?$LOTUS_L[confirm_un]" || { print; say $LOTUS_L[cancelled]; return 1 }
    print
  fi

  cmd_unhook
  [[ -e $LOTUS_CONF/hushlogin-by-lotus ]] && rm -f $HOME/.hushlogin
  rm -rf $LOTUS_CONF $LOTUS_CACHE

  if is_brew; then
    say $LOTUS_L[removed_brew]
    local kind=--formula
    [[ $LOTUS_ROOT == */Caskroom/* ]] && kind=--cask
    HOMEBREW_NO_AUTOREMOVE=1 brew uninstall --quiet $kind lotus
    brew untap --quiet fanxy13/lotus 2>/dev/null
    say $LOTUS_L[ff_kept]
  elif [[ $LOTUS_ROOT == $HOME/.local/share/lotus ]]; then
    rm -f $HOME/.local/bin/lotus
    rm -rf $LOTUS_ROOT
  else
    say "$LOTUS_L[own_install] $LOTUS_ROOT"
  fi
  say $LOTUS_L[removed]
}

# Removes the lotus lines from ~/.zshrc (also used by `brew uninstall lotus`)
cmd_unhook() {
  [[ -r $LOTUS_RC ]] || return 0
  local rc=$(<$LOTUS_RC)
  [[ $rc == *'# >>> lotus >>>'* ]] || return 0
  rc=${rc/$'\n'#'# >>> lotus >>>'*'# <<< lotus <<<'/}
  print -r -- $rc >| $LOTUS_RC
  say "$LOTUS_L[removed_from] $LOTUS_RC"
}

cmd_update() {
  if is_brew; then
    brew upgrade fanxy13/lotus/lotus
  else
    curl -fsSL https://raw.githubusercontent.com/$LOTUS_REPO/main/install.sh | zsh
  fi
}

cmd_doctor() {
  local ok="%F{green}✓%f" bad="%F{red}✗%f"
  print -P "lotus $LOTUS_VERSION  ($LOTUS_ROOT)"
  if [[ -x $LOTUS_FF ]]; then
    print -P "$ok fastfetch  $($LOTUS_FF --version 2>/dev/null)  ($LOTUS_FF)"
  else
    print -P "$bad fastfetch  $LOTUS_L[doc_missing]"
  fi
  print -P "$ok ${(r:10:)LOTUS_L[doc_colors]} $LOTUS_MODE (${TERM_PROGRAM:-$LOTUS_L[unknown_term]})"
  print -P "$ok Settings   $LOTUS_CONF/settings.zsh"
  if [[ -r $LOTUS_RC && $(<$LOTUS_RC) == *'# >>> lotus >>>'* ]]; then
    print -P "$ok .zshrc     $LOTUS_L[doc_rc_ok]"
  else
    print -P "$bad .zshrc     $LOTUS_L[doc_rc_no]"
  fi
  lotus_build
  lotus_np_query
  print -P "$ok ${(r:10:)LOTUS_L[doc_music]} ${${(f)"$(<$LOTUS_CACHE/np-$LOTUS_MODE-$LOTUS_LANG)"}[1]}"
}

lotus_load
case $1 in
  ''|show)          lotus_render ;;
  settings|config)  source $LOTUS_ROOT/lib/settings.zsh; lotus_settings_ui; exit $? ;;
  setup)            cmd_setup ;;
  update|upgrade)   cmd_update ;;
  doctor)           cmd_doctor ;;
  uninstall)        cmd_uninstall $2 ;;
  unhook)           cmd_unhook ;;
  version|-v|--version) print -r -- $LOTUS_VERSION ;;
  help|-h|--help)   printf "$LOTUS_L[usage]\n" $LOTUS_VERSION ;;
  *)                printf "$LOTUS_L[usage]\n" $LOTUS_VERSION; exit 1 ;;
esac
